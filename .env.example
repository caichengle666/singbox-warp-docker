# Copy to .env and modify as needed
HY2_PORT=32443
VLESS_PORT=38443
MIXED_PORT=1080
ENABLE_HY2=true
ENABLE_VLESS=true
AUTO_DOMAIN=true
BASE_DOMAIN=1100.ccwu.cc
AUTH_UUID=
HY2_PASSWORD=
VLESS_UUID=
SINGBOX_VERSION=1.11.8
WGCF_VERSION=2.2.26
AUTO_TLS=false
TLS_DOMAIN=example.com
TLS_CERT_PATH=/etc/sing-box/certs/fullchain.pem
TLS_KEY_PATH=/etc/sing-box/certs/privkey.pem
ACME_EMAIL=admin@example.com
TLS_ISSUE_RETRIES=3
TLS_RENEW_INTERVAL=43200
WARP_LICENSE_KEY=
CF_Token=
CF_Account_ID=
CF_Zone_ID=
