# Copy to .env and modify as needed
HY2_PORT=32443
VLESS_PORT=38443
ANYTLS_PORT=4443
SS_PORT=48443
MIXED_PORT=1080
ENABLE_HY2=true
ENABLE_VLESS=true
ENABLE_ANYTLS=false
ENABLE_SS=false
AUTO_DOMAIN=true
BASE_DOMAIN=1100.ccwu.cc
AUTH_UUID=
HY2_PASSWORD=
VLESS_UUID=
ANYTLS_PASSWORD=
SS_PASSWORD=
AUTO_TLS=false
TLS_DOMAIN=example.com
TLS_CERT_PATH=/etc/sing-box/certs/fullchain.pem
TLS_KEY_PATH=/etc/sing-box/certs/privkey.pem
ACME_EMAIL=admin@example.com
TLS_ISSUE_RETRIES=3
TLS_RENEW_INTERVAL=43200
WARP_LICENSE_KEY=
CF_Token=
CF_Account_ID=
CF_Zone_ID=
