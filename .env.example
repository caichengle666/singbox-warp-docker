# Copy to .env and modify as needed
HY2_PORT=32443
HY2_PORT_HOPPING=false
HY2_HOP_PORTS=
VLESS_PORT=38443
ANYTLS_PORT=4443
SS_PORT=48443
MIXED_PORT=1080
ENABLE_HY2=true
ENABLE_VLESS=true
ENABLE_ANYTLS=false
ENABLE_SS=false
TUIC_PORT=36443
ENABLE_TUIC=false
REALITY_PORT=443
ENABLE_REALITY=false
REALITY_SNI=www.microsoft.com
REALITY_SHORT_ID=
# 隧道模式（VLESS-WS，配合 cloudflared；见 docker-compose.tunnel.yml）
ENABLE_WS=false
WS_PORT=8080
WS_PATH=
WS_HOST=
WS_ADDRESS=
# 仅 docker-compose.tunnel.yml 使用
CF_TUNNEL_TOKEN=
CF_TUNNEL_PROTOCOL=auto
AUTO_DOMAIN=true
BASE_DOMAIN=1100.ccwu.cc
NODE_NAME=
AUTH_UUID=
HY2_PASSWORD=
VLESS_UUID=
ANYTLS_PASSWORD=
SS_PASSWORD=
TUIC_PASSWORD=
AUTO_TLS=false
TLS_DOMAIN=example.com
TLS_CERT_PATH=/etc/sing-box/certs/fullchain.pem
TLS_KEY_PATH=/etc/sing-box/certs/privkey.pem
ACME_EMAIL=admin@example.com
TLS_ISSUE_RETRIES=3
TLS_RENEW_INTERVAL=43200
WARP_LICENSE_KEY=
WARP_MODE=auto
WARP_SCOPE=all
WARP_SPLIT_GEOSITE=openai,anthropic,google-gemini,netflix,disney
WARP_SPLIT_DOMAINS=
WARP_AUTORECOVER=true
WARP_PROBE_INTERVAL=60
USQUE_HTTP2=true
CF_Token=
CF_Account_ID=
CF_Zone_ID=
