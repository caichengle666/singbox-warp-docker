{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "hysteria2",
      "tag": "__HY2_TAG__",
      "listen": "::",
      "listen_port": __HY2_PORT__,
      "users": [
        {
          "password": "__HY2_PASSWORD__"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "__TLS_DOMAIN__",
        "certificate_path": "__TLS_CERT_PATH__",
        "key_path": "__TLS_KEY_PATH__"
      }
    },
    {
      "type": "vless",
      "tag": "__VLESS_TAG__",
      "listen": "::",
      "listen_port": __VLESS_PORT__,
      "users": [
        {
          "uuid": "__VLESS_UUID__",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "__TLS_DOMAIN__",
        "certificate_path": "__TLS_CERT_PATH__",
        "key_path": "__TLS_KEY_PATH__"
      }
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "0.0.0.0",
      "listen_port": __MIXED_PORT__
    }
  ],
  "endpoints": [
    {
      "type": "wireguard",
      "tag": "warp",
      "system": false,
      "mtu": 1280,
      "address": [
        "__WARP_ADDRESS_V4__",
        "__WARP_ADDRESS_V6__"
      ],
      "private_key": "__WARP_PRIVATE_KEY__",
      "peers": [
        {
          "address": "__WARP_PEER_HOST__",
          "port": __WARP_PEER_PORT__,
          "public_key": "__WARP_PEER_PUBLIC_KEY__",
          "allowed_ips": [
            "0.0.0.0/0",
            "::/0"
          ]
        }
      ]
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "action": "route",
        "outbound": "warp"
      }
    ]
  }
}
