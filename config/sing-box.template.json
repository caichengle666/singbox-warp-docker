{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "hysteria2",
      "tag": "__HY2_TAG__",
      "listen": "::",
      "listen_port": __HY2_PORT__,
      "users": [
        {
          "password": "__HY2_PASSWORD__"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "__TLS_DOMAIN__",
        "certificate_path": "__TLS_CERT_PATH__",
        "key_path": "__TLS_KEY_PATH__"
      }
    },
    {
      "type": "vless",
      "tag": "__VLESS_TAG__",
      "listen": "::",
      "listen_port": __VLESS_PORT__,
      "users": [
        {
          "uuid": "__VLESS_UUID__",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "__TLS_DOMAIN__",
        "certificate_path": "__TLS_CERT_PATH__",
        "key_path": "__TLS_KEY_PATH__"
      }
    },
    {
      "type": "anytls",
      "tag": "anytls-in",
      "listen": "::",
      "listen_port": __ANYTLS_PORT__,
      "users": [
        {
          "name": "default",
          "password": "__ANYTLS_PASSWORD__"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "__TLS_DOMAIN__",
        "certificate_path": "__TLS_CERT_PATH__",
        "key_path": "__TLS_KEY_PATH__"
      }
    },
    {
      "type": "shadowsocks",
      "tag": "ss-in",
      "listen": "::",
      "listen_port": __SS_PORT__,
      "network": "tcp",
      "method": "2022-blake3-aes-256-gcm",
      "password": "__SS_PASSWORD__"
    },
    {
      "type": "vless",
      "tag": "reality-in",
      "listen": "::",
      "listen_port": __REALITY_PORT__,
      "users": [
        {
          "uuid": "__VLESS_UUID__",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "__REALITY_SNI__",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "__REALITY_SNI__",
            "server_port": 443
          },
          "private_key": "__REALITY_PRIVATE_KEY__",
          "short_id": [
            "__REALITY_SHORT_ID__"
          ]
        }
      }
    },
    {
      "type": "tuic",
      "tag": "tuic-in",
      "listen": "::",
      "listen_port": __TUIC_PORT__,
      "users": [
        {
          "uuid": "__VLESS_UUID__",
          "password": "__TUIC_PASSWORD__"
        }
      ],
      "congestion_control": "bbr",
      "tls": {
        "enabled": true,
        "server_name": "__TLS_DOMAIN__",
        "alpn": [
          "h3"
        ],
        "certificate_path": "__TLS_CERT_PATH__",
        "key_path": "__TLS_KEY_PATH__"
      }
    },
    {
      "type": "mixed",
      "tag": "warp-probe",
      "listen": "127.0.0.1",
      "listen_port": 18080
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "0.0.0.0",
      "listen_port": __MIXED_PORT__
    }
  ],
  "endpoints": [
    {
      "type": "wireguard",
      "tag": "warp",
      "system": false,
      "mtu": 1280,
      "address": [
        "__WARP_ADDRESS_V4__",
        "__WARP_ADDRESS_V6__"
      ],
      "private_key": "__WARP_PRIVATE_KEY__",
      "peers": [
        {
          "address": "__WARP_PEER_HOST__",
          "port": __WARP_PEER_PORT__,
          "public_key": "__WARP_PEER_PUBLIC_KEY__",
          "allowed_ips": [
            "0.0.0.0/0",
            "::/0"
          ]
        }
      ]
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "socks",
      "tag": "usque",
      "server": "127.0.0.1",
      "server_port": 18081
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "rules": [
      {
        "inbound": ["warp-probe"],
        "action": "route",
        "outbound": "warp"
      },
      {
        "ip_is_private": true,
        "action": "reject"
      }
    ],
    "final": "direct"
  }
}
